import java.util.Stack;

class Solution {
    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();
        
        for (char c : s.toCharArray()) {
            // Push expected closing brackets onto the stack for every open bracket
            if (c == '(') {
                stack.push(')');
            } else if (c == '{') {
                stack.push('}');
            } else if (c == '[') {
                stack.push(']');
            } 
            // If it's a closing bracket, check if stack is empty or top doesn't match
            else if (stack.isEmpty() || stack.pop() != c) {
                return false;
            }
        }
        
        // The string is valid only if all opening brackets were matched and popped
        return stack.isEmpty();
    }
}
