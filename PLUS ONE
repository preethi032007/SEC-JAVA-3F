class Solution {
    public int[] plusOne(int[] digits) {
        // Traverse the array from right to left (least significant digit to most)
        for (int i = digits.length - 1; i >= 0; i--) {
            // If the current digit is less than 9, just increment it and return
            if (digits[i] < 9) {
                digits[i]++;
                return digits;
            }
            // If the digit is 9, it becomes 0 and the carry moves to the left digit
            digits[i] = 0;
        }
        
        // If all digits were 9 (e.g., [9, 9] -> [1, 0, 0]), create a new array
        int[] result = new int[digits.length + 1];
        result[0] = 1; // The first digit is 1, and the rest are already 0 by default
        return result;
    }
}


